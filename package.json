{
  "name": "gnomon",
  "private": true,
  "type": "module",
  "description": "Gnomon: a portable, model-agnostic second brain. Monorepo for the companion PWA, shared library, and desktop CLI.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "validate:template": "node packages/cli/dist/gnomon.js validate template",
    "validate:fixture": "node packages/cli/dist/gnomon.js validate packages/core/fixtures/brain",
    "build:cli": "npm run build -w packages/cli",
    "validate:reference": "python3 tools/gnomon-check.py template && python3 tools/gnomon-check.py packages/core/fixtures/brain"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
