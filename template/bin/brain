#!/usr/bin/env bash
# Where the brain stands. Read-only: this script never changes anything.
#
# Every count below must survive an empty brain — no sources, no
# principles, no proposals. A status command that dies on a fresh clone is
# worse than none.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# Count lines of a command's output, treating "no matches" as zero rather
# than as failure.
n() { "$@" 2>/dev/null | grep -c . || true; }

inbox=$(n find inbox -maxdepth 1 -type f ! -name README.md)
srcs=$(n find sources -mindepth 1 -maxdepth 1 -type d)
unrat=$(n grep -rl 'curated: agent-proposed' sources)
princ=$(n find principles -maxdepth 1 -name '*.md' ! -name '_index.md')
inforce=$(sed -n '/^## In force/,/^## /p' principles/_index.md 2>/dev/null \
          | grep -c '^- ' || true)
open=$(grep -c '^\*\*Decision:\*\* *$' maps/_proposals.md 2>/dev/null || true)
decided=$(grep -c '^\*\*Decision:\*\* *[^ ]' maps/_proposals.md 2>/dev/null || true)

nudge() { [ "$1" -gt 0 ] && printf '  → %s' "$2" || true; }

echo
printf '  inbox            %s unfiled' "$inbox";        nudge "$inbox" "/file-inbox"; echo
printf '  sources          %s filed, %s unratified\n' "$srcs" "$unrat"
printf '  principles       %s written, %s in force\n' "$princ" "$inforce"
printf '  proposals        %s open, %s decided' "$open" "$decided"
                                                        nudge "$decided" "/proposals"; echo
echo

if [ "$inforce" -eq 0 ]; then
  if [ "$princ" -eq 0 ]; then
    echo "  No principles yet, so /reason and /relate are inert."
    echo "  Start: cp templates/principle.md principles/<slug>.md"
  else
    echo "  Principles exist but none are in force, so /reason is inert."
    echo "  List one under 'In force' in principles/_index.md."
  fi
  echo
fi

if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
  echo "  Uncommitted:"
  git status --short | sed 's/^/    /'
  echo
fi
